+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// The original array-walking context manager, kept as the reference the
+    /// Fenwick histogram must match exactly.
+    struct Reference {
+        sym: Option<Vec<u16>>,
+        cum: Option<Vec<u16>>,
+    }
+
+    impl Reference {
+        fn add(&mut self, symbol: u32) {
+            if symbol >= MAXIMUM_SYMBOL_IN_HISTOGRAM { return; }
+            let needs_resize = match &self.cum { None => true, Some(v) => v.len() <= symbol as usize };
+            if needs_resize {
+                let new_len = symbol as usize + ARRAY_SIZE_INCR;
+                let mut new_cum = vec![0u16; new_len];
+                let mut new_sym = vec![0u16; new_len];
+                match (&self.cum, &self.sym) {
+                    (Some(c), Some(s)) => { new_cum[..c.len()].copy_from_slice(c); new_sym[..s.len()].copy_from_slice(s); }
+                    _ => { new_cum[0] = 1; new_sym[0] = 1; }
+                }
+                self.cum = Some(new_cum);
+                self.sym = Some(new_sym);
+            }
+            let cum = self.cum.as_mut().unwrap();
+            let sym = self.sym.as_mut().unwrap();
+            if cum[0] >= ELEPHANT {
+                let mut acc: u16 = 0;
+                for i in (0..cum.len()).rev() { sym[i] >>= 1; acc += sym[i]; cum[i] = acc; }
+                sym[0] += 1;
+                cum[0] += 1;
+            }
+            sym[symbol as usize] += 1;
+            for i in 0..=symbol as usize { cum[i] += 1; }
+        }
+        fn freq(&self, s: u32) -> u32 {
+            if let Some(v) = &self.sym { if (s as usize) < v.len() { return v[s as usize] as u32; } }
+            if s == 0 { 1 } else { 0 }
+        }
+        fn cum_freq(&self, s: u32) -> u32 {
+            match &self.cum { Some(c) => if (s as usize) < c.len() { (c[0] - c[s as usize]) as u32 } else { c[0] as u32 }, None => 0 }
+        }
+        fn total(&self) -> u32 { match &self.cum { Some(c) => c[0] as u32, None => 1 } }
+        fn from_freq(&self, f: u32) -> u32 {
+            let c = match &self.cum { Some(c) => c, None => return 0 };
+            if f == 0 || (c[0] as u32) < f { return 0; }
+            let mut r = 0;
+            for i in 0..c.len() as u32 { if self.cum_freq(i) <= f { r = i; } else { break; } }
+            r
+        }
+    }
+
+    #[test]
+    fn fenwick_histogram_matches_reference() {
+        let mut seed: u64 = 0x5EED_5EED;
+        let mut rnd = |m: u32| { seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407); ((seed >> 33) as u32) % m };
+        for round in 0..20 {
+            let mut bs = IFXBitStreamCompressed::new(&[0u8; 16]);
+            let ctx = 1 + round;
+            let mut reference = Reference { sym: None, cum: None };
+            // Mostly small symbols, sometimes large jumps (forces growth past the
+            // Fenwick capacity) and an occasional out-of-range symbol.
+            let range = [8u32, 64, 600, 5000, 70000][round as usize % 5];
+            for _ in 0..10_000 {
+                let s = if rnd(50) == 0 { rnd(70000) } else { rnd(range) };
+                bs.add_symbol(ctx, s);
+                reference.add(s);
+                let total = reference.total();
+                assert_eq!(bs.get_total_symbol_frequency(ctx), total);
+                if rnd(100) == 0 {
+                    // Exhaustive sweep: every lookup value the decoder can ask for.
+                    for q in 0..=total + 1 {
+                        assert_eq!(bs.get_symbol_from_frequency(ctx, q), reference.from_freq(q), "sweep from_freq({q})");
+                    }
+                    let len = reference.sym.as_ref().unwrap().len() as u32;
+                    for probe in 0..len + 2 {
+                        assert_eq!(bs.get_cumulative_symbol_frequency(ctx, probe), reference.cum_freq(probe), "sweep cum({probe})");
+                    }
+                }
+                for _ in 0..3 {
+                    let q = rnd(total + 2);
+                    assert_eq!(bs.get_symbol_from_frequency(ctx, q), reference.from_freq(q), "from_freq({q})");
+                    let probe = rnd(range + 40);
+                    assert_eq!(bs.get_cumulative_symbol_frequency(ctx, probe), reference.cum_freq(probe), "cum({probe})");
+                    assert_eq!(bs.get_symbol_frequency(ctx, probe), reference.freq(probe), "freq({probe})");
+                }
+            }
+        }
+    }
+}
