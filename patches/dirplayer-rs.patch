+/// Adaptive symbol histogram for one dynamic context.
+///
+/// Same model as IFX's symbol/cumulative count arrays — including the array
+/// growth rule (`symbol + ARRAY_SIZE_INCR`) and the halving rescale at
+/// `ELEPHANT` — but cumulative frequencies come from a Fenwick tree, so a
+/// lookup or update is O(log n) instead of a walk over up to 64K entries.
+#[derive(Clone)]
+struct Histogram {
+    /// Per-symbol counts; `sym.len()` is the IFX array length.
+    sym: Vec<u16>,
+    /// 1-indexed Fenwick tree over `sym`, sized to a power of two >= `sym.len()`.
+    tree: Vec<u32>,
+    total: u32,
+}
+
+impl Histogram {
+    fn new(len: usize) -> Self {
+        let mut sym = vec![0u16; len];
+        sym[0] = 1; // escape symbol
+        let mut h = Self { sym, tree: Vec::new(), total: 0 };
+        h.rebuild();
+        h
+    }
+
+    fn capacity(&self) -> usize {
+        self.tree.len() - 1
+    }
+
+    fn rebuild(&mut self) {
+        let cap = self.sym.len().next_power_of_two();
+        let mut tree = vec![0u32; cap + 1];
+        for (i, &c) in self.sym.iter().enumerate() {
+            tree[i + 1] = c as u32;
+        }
+        // Push every node into its parent, including the zero padding past
+        // `sym.len()` — those nodes still carry their children's sums.
+        for i in 1..=cap {
+            let parent = i + (i & i.wrapping_neg());
+            if parent <= cap {
+                tree[parent] += tree[i];
+            }
+        }
+        self.total = self.sym.iter().map(|&c| c as u32).sum();
+        self.tree = tree;
+    }
+
+    fn increment(&mut self, symbol: usize) {
+        self.sym[symbol] += 1;
+        self.total += 1;
+        let cap = self.capacity();
+        let mut i = symbol + 1;
+        while i <= cap {
+            self.tree[i] += 1;
+            i += i & i.wrapping_neg();
+        }
+    }
+
+    /// Sum of counts of symbols `0..symbol`.
+    fn prefix(&self, symbol: usize) -> u32 {
+        let mut i = symbol.min(self.capacity());
+        let mut sum = 0;
+        while i > 0 {
+            sum += self.tree[i];
+            i -= i & i.wrapping_neg();
+        }
+        sum
+    }
+
+    /// Largest symbol below `sym.len()` whose prefix sum is <= `freq`.
+    fn find(&self, freq: u32) -> usize {
+        let cap = self.capacity();
+        let mut pos = 0usize;
+        let mut rem = freq;
+        let mut step = cap;
+        while step > 0 {
+            let next = pos + step;
+            if next <= cap && self.tree[next] <= rem {
+                pos = next;
+                rem -= self.tree[next];
+            }
+            step >>= 1;
+        }
+        pos.min(self.sym.len() - 1)
+    }
 }
 
