@@ -0,0 +1,35 @@
+//! LOCAL TEST (Sewer Run): digest decoded CLOD meshes of real W3D chunks so two
+//! decoder implementations can be compared. Run with W3D_DIR=<dir of XMED-*.bin>.
+#[cfg(test)]
+mod tests {
+    use super::super::parser::W3dFileParser;
+    use std::collections::hash_map::DefaultHasher;
+    use std::hash::{Hash, Hasher};
+
+    #[test]
+    #[ignore]
+    fn digest_real_w3d() {
+        let dir = std::env::var("W3D_DIR").expect("W3D_DIR");
+        let mut files: Vec<_> = std::fs::read_dir(&dir).unwrap().filter_map(|e| e.ok()).map(|e| e.path())
+            .filter(|p| p.file_name().unwrap().to_string_lossy().starts_with("XMED")).collect();
+        files.sort();
+        for f in files {
+            let data = std::fs::read(&f).unwrap();
+            if &data[..4] != b"3DEM" { continue; }
+            let t0 = std::time::Instant::now();
+            let ifx = data.windows(4).position(|w| w == b"IFX\0").expect("IFX magic");
+            let mut p = W3dFileParser::new(data[ifx..].to_vec());
+            let res = p.parse();
+            let mut keys: Vec<_> = p.scene.clod_meshes.keys().cloned().collect();
+            keys.sort_by(|a, b| format!("{:?}", a).cmp(&format!("{:?}", b)));
+            let mut h = DefaultHasher::new();
+            let mut verts = 0usize;
+            for k in &keys {
+                let meshes = &p.scene.clod_meshes[k];
+                format!("{:?}", meshes).hash(&mut h);
+                verts += format!("{:?}", meshes).len();
+            }
+            println!("{} ok={} meshes={} dbg_len={} digest={:016x} ms={}", f.file_name().unwrap().to_string_lossy(), res.is_ok(), keys.len(), verts, h.finish(), t0.elapsed().as_millis());
+        }
+    }
+}
