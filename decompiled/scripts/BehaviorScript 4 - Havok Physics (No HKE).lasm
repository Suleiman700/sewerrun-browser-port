on getHavokCastMembers me, aList
  [  0] pushint8 1 .............................. <1>
  [  2] setlocal 0
  [  4] getlocal 0
  [  6] pushint8 1 .............................. <1>
  [  8] pushint8 2 .............................. <2>
  [ 10] get 8 ................................... <the number of castMembers of castLib 1>
  [ 12] lteq
  [ 13] jmpifz [ 61] ............................ repeat with j = 1 to the number of castMembers of castLib 1
  [ 16] getlocal 0 .............................. <j>
  [ 18] pusharglist 1 ........................... <j>
  [ 20] extcall 108 ............................. <member(j)>
  [ 22] getobjprop 190 .......................... <member(j).type>
  [ 24] pushsymb 675 ............................ <#havok>
  [ 27] eq ...................................... <member(j).type = #havok>
  [ 28] jmpifz [ 52] ............................ if member(j).type = #havok then
  [ 31] getparam 1 .............................. <aList>
  [ 33] getlocal 0 .............................. <j>
  [ 35] pushcons 12 ............................. <":">
  [ 37] joinstr ................................. <j & ":">
  [ 38] getlocal 0 .............................. <j>
  [ 40] pusharglist 1 ........................... <j>
  [ 42] extcall 108 ............................. <member(j)>
  [ 44] getobjprop 259 .......................... <member(j).name>
  [ 47] joinstr ................................. <j & ":" & member(j).name>
  [ 48] pusharglistnoret 2 ...................... <aList, j & ":" & member(j).name>
  [ 50] objcall 233 ............................. aList.add(j & ":" & member(j).name)
  [ 52] pushint8 1
  [ 54] getlocal 0
  [ 56] add
  [ 57] setlocal 0
  [ 59] endrepeat [  4]
  [ 61] getparam 1 .............................. <aList>
  [ 63] pushcons 15 ............................. <"None">
  [ 65] pusharglistnoret 2 ...................... <aList, "None">
  [ 67] objcall 233 ............................. aList.add("None")
  [ 69] getparam 1 .............................. <aList>
  [ 71] pusharglistnoret 1 ...................... <aList>
  [ 73] extcall 107 ............................. return aList
  [ 75] ret
end

on getHavokCastMember me, memberName
  [  0] getparam 1 .............................. <memberName>
  [  2] pushcons 12 ............................. <":">
  [  4] getparam 1 .............................. <memberName>
  [  6] pusharglist 2 ........................... <":", memberName>
  [  8] extcall 445 ............................. <offset(":", memberName)>
  [ 11] pushint8 1 .............................. <1>
  [ 13] add ..................................... <offset(":", memberName) + 1>
  [ 14] getparam 1 .............................. <memberName>
  [ 16] getobjprop 260 .......................... <memberName.length>
  [ 19] pusharglist 3 ........................... <memberName, offset(":", memberName) + 1, memberName.length>
  [ 21] extcall 258 ............................. <chars(memberName, offset(":", memberName) + 1, memberName.length)>
  [ 24] setlocal 0 .............................. nameStr = chars(memberName, offset(":", memberName) + 1, memberName.length)
  [ 26] getparam 1 .............................. <memberName>
  [ 28] pushint8 1 .............................. <1>
  [ 30] pushcons 12 ............................. <":">
  [ 32] getparam 1 .............................. <memberName>
  [ 34] pusharglist 2 ........................... <":", memberName>
  [ 36] extcall 445 ............................. <offset(":", memberName)>
  [ 39] pushint8 1 .............................. <1>
  [ 41] sub ..................................... <offset(":", memberName) - 1>
  [ 42] pusharglist 3 ........................... <memberName, 1, offset(":", memberName) - 1>
  [ 44] extcall 258 ............................. <chars(memberName, 1, offset(":", memberName) - 1)>
  [ 47] setlocal 1 .............................. nameInt = chars(memberName, 1, offset(":", memberName) - 1)
  [ 49] getlocal 1 .............................. <nameInt>
  [ 51] pusharglist 1 ........................... <nameInt>
  [ 53] extcall 25 .............................. <integer(nameInt)>
  [ 55] setlocal 1 .............................. nameInt = integer(nameInt)
  [ 57] getlocal 1 .............................. <nameInt>
  [ 59] pusharglist 1 ........................... <nameInt>
  [ 61] extcall 108 ............................. <member(nameInt)>
  [ 63] pusharglistnoret 1 ...................... <member(nameInt)>
  [ 65] extcall 107 ............................. return member(nameInt)
  [ 67] ret
end
