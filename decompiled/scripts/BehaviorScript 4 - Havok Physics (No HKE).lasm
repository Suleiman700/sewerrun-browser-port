  [ 21] pushcons 9 .............................. <RETURN>
  [ 23] joinstr ................................. <"-" && "Type" && ":" && "Independent Action" & RETURN>
  [ 24] setlocal 1 .............................. tString2 = "-" && "Type" && ":" && "Independent Action" & RETURN
  [ 26] pushcons 10 ............................. <"-">
  [ 28] pushcons 14 ............................. <"Dependencies">
  [ 30] joinpadstr .............................. <"-" && "Dependencies">
  [ 31] pushcons 12 ............................. <":">
  [ 33] joinpadstr .............................. <"-" && "Dependencies" && ":">
  [ 34] pushcons 15 ............................. <"None">
  [ 36] joinpadstr .............................. <"-" && "Dependencies" && ":" && "None">
  [ 37] pushcons 9 .............................. <RETURN>
  [ 39] joinstr ................................. <"-" && "Dependencies" && ":" && "None" & RETURN>
  [ 40] setlocal 2 .............................. tString3 = "-" && "Dependencies" && ":" && "None" & RETURN
  [ 42] getlocal 0 .............................. <tString1>
  [ 44] getlocal 1 .............................. <tString2>
  [ 46] joinstr ................................. <tString1 & tString2>
  [ 47] getlocal 2 .............................. <tString3>
  [ 49] joinstr ................................. <tString1 & tString2 & tString3>
  [ 50] pusharglistnoret 1 ...................... <tString1 & tString2 & tString3>
  [ 52] extcall 107 ............................. return tString1 & tString2 & tString3
  [ 54] ret
end

