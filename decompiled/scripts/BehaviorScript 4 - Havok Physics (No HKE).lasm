property pInitialized, pHavok, pTimeStep, pSubSteps, pPaused, pScale, pTolerance, pSprite
global gHavok, gPaused, gTimeFactor, gFPSFactor

on beginSprite me
  [  0] getparam 0 .............................. <me>
  [  2] getprop 199 ............................. <pHavok>
  [  4] pusharglist 2 ........................... <me, pHavok>
  [  6] objcall 650 ............................. <me.getHavokCastMember(pHavok)>
  [  9] setprop 199 ............................. pHavok = me.getHavokCastMember(pHavok)
  [ 11] getparam 0 .............................. <me>
  [ 13] pusharglistnoret 1 ...................... <me>
  [ 15] objcall 643 ............................. me.initializePhysics()
  [ 18] pushfloat32 1.0 ......................... <1.0>
  [ 23] setglobal 99 ............................ gTimeFactor = 1.0
  [ 25] pushfloat32 1.0 ......................... <1.0>
  [ 30] setglobal 493 ........................... gFPSFactor = 1.0
  [ 33] ret
end

on endSprite me
  [  0] getprop 651 ............................. <pInitialized>
  [  3] jmpifz [ 17] ............................ if pInitialized then
  [  6] getprop 199 ............................. <pHavok>
  [  8] pusharglistnoret 1 ...................... <pHavok>
  [ 10] objcall 634 ............................. pHavok.shutDown()
  [ 13] pushzero ................................ <0>
  [ 14] setprop 651 ............................. pInitialized = 0
  [ 17] ret
end

on exitFrame me
  [  0] getglobal 493 ........................... <gFPSFactor>
  [  3] pushfloat32 2.0 ......................... <2.0>
  [  8] gt ...................................... <gFPSFactor > 2.0>
  [  9] jmpifz [ 20] ............................ if gFPSFactor > 2.0 then
  [ 12] pushfloat32 2.0 ......................... <2.0>
  [ 17] setglobal 493 ........................... gFPSFactor = 2.0
  [ 20] getglobal 493 ........................... <gFPSFactor>
  [ 23] pushfloat32 0.5 ......................... <0.5>
  [ 28] lt ...................................... <gFPSFactor < 0.5>
  [ 29] jmpifz [ 40] ............................ if gFPSFactor < 0.5 then
  [ 32] pushfloat32 0.5 ......................... <0.5>
  [ 37] setglobal 493 ........................... gFPSFactor = 0.5
  [ 40] getglobal 99 ............................ <gTimeFactor>
  [ 42] pushzero ................................ <0>
  [ 43] gt ...................................... <gTimeFactor > 0>
  [ 44] jmpifz [ 67] ............................ if gTimeFactor > 0 then
  [ 47] getprop 199 ............................. <pHavok>
  [ 49] getprop 652 ............................. <pTimeStep>
  [ 52] getglobal 99 ............................ <gTimeFactor>
  [ 54] mul ..................................... <pTimeStep * gTimeFactor>
  [ 55] getglobal 493 ........................... <gFPSFactor>
  [ 58] mul ..................................... <pTimeStep * gTimeFactor * gFPSFactor>
  [ 59] getprop 653 ............................. <pSubSteps>
  [ 62] pusharglistnoret 3 ...................... <pHavok, pTimeStep * gTimeFactor * gFPSFactor, pSubSteps>
  [ 64] objcall 654 ............................. pHavok.step(pTimeStep * gTimeFactor * gFPSFactor, pSubSteps)
  [ 67] ret
end

on initializePhysics me
  [  0] pushzero ................................ <0>
  [  1] setglobal 641 ........................... gPaused = 0
  [  4] getparam 0 .............................. <me>
  [  6] getobjprop 198 .......................... <me.spriteNum>
  [  8] pusharglist 1 ........................... <me.spriteNum>
  [ 10] extcall 26 .............................. <sprite(me.spriteNum)>
  [ 12] setprop 655 ............................. pSprite = sprite(me.spriteNum)
  [ 15] getprop 199 ............................. <pHavok>
  [ 17] pusharglist 1 ........................... <pHavok>
  [ 19] extcall 108 ............................. <member(pHavok)>
  [ 21] setprop 199 ............................. pHavok = member(pHavok)
  [ 23] getprop 651 ............................. <pInitialized>
  [ 26] jmpifz [ 36] ............................ if pInitialized then
  [ 29] getprop 199 ............................. <pHavok>
  [ 31] pusharglistnoret 1 ...................... <pHavok>
  [ 33] objcall 634 ............................. pHavok.shutDown()
  [ 36] pushint8 1 .............................. <1>
  [ 38] setprop 651 ............................. pInitialized = 1
  [ 41] getprop 199 ............................. <pHavok>
  [ 43] getprop 655 ............................. <pSprite>
  [ 46] getobjprop 108 .......................... <pSprite.member>
  [ 48] getprop 656 ............................. <pTolerance>
  [ 51] getprop 657 ............................. <pScale>
  [ 54] pusharglistnoret 4 ...................... <pHavok, pSprite.member, pTolerance, pScale>
  [ 56] objcall 200 ............................. pHavok.Initialize(pSprite.member, pTolerance, pScale)
  [ 58] getprop 199 ............................. <pHavok>
  [ 60] setglobal 658 ........................... gHavok = pHavok
  [ 63] pushcons 0 .............................. <"Initialized Physics">
  [ 65] pusharglistnoret 1 ...................... <"Initialized Physics">
  [ 67] extcall 100 ............................. put "Initialized Physics"
  [ 69] ret
end

on togglePausePhysics me
  [  0] getprop 659 ............................. <pPaused>
  [  3] not ..................................... <not pPaused>
  [  4] setprop 659 ............................. pPaused = not pPaused
  [  7] ret
end

on isOKToAttach aScript, aSpriteType, aSpriteNum
  [  0] getparam 1 .............................. <aSpriteType>
  [  2] peek 0 .................................. case aSpriteType of
  [  4] pushsymb 660 ............................ <#graphic>
  [  7] eq
  [  8] jmpifz [ 89] ............................ (case) #graphic:
  [ 11] getparam 2 .............................. <aSpriteNum>
  [ 13] pusharglist 1 ........................... <aSpriteNum>
  [ 15] extcall 26 .............................. <sprite(aSpriteNum)>
  [ 17] getchainedprop 108 ...................... <sprite(aSpriteNum).member>
  [ 19] getobjprop 190 .......................... <sprite(aSpriteNum).member.type>
  [ 21] peek 0 .................................. case sprite(aSpriteNum).member.type of
  [ 23] pushsymb 191 ............................ <#shockwave3d>
  [ 25] eq
  [ 26] jmpifz [ 40] ............................ (case) #shockwave3d:
  [ 29] pop 2
  [ 31] pushint8 1 .............................. <1>
  [ 33] pusharglistnoret 1 ...................... <1>
  [ 35] extcall 107 ............................. return 1
  [ 37] jmp [ 84]
  [ 40] peek 0
  [ 42] pushsymb 229 ............................ <#text>
  [ 44] eq
  [ 45] jmpifz [ 84] ............................ (case) #text:
  [ 48] getparam 2 .............................. <aSpriteNum>
  [ 50] pusharglist 1 ........................... <aSpriteNum>
  [ 52] extcall 26 .............................. <sprite(aSpriteNum)>
  [ 54] getchainedprop 108 ...................... <sprite(aSpriteNum).member>
  [ 56] getobjprop 661 .......................... <sprite(aSpriteNum).member.displayMode>
  [ 59] pushsymb 662 ............................ <#mode3d>
  [ 62] eq ...................................... <sprite(aSpriteNum).member.displayMode = #mode3d>
  [ 63] jmpifz [ 77] ............................ if sprite(aSpriteNum).member.displayMode = #mode3d then / else
  [ 66] pop 2
  [ 68] pushint8 1 .............................. <1>
  [ 70] pusharglistnoret 1 ...................... <1>
  [ 72] extcall 107 ............................. return 1
  [ 74] jmp [ 84]
  [ 77] pop 2
  [ 79] pushzero ................................ <0>
  [ 80] pusharglistnoret 1 ...................... <0>
  [ 82] extcall 107 ............................. return 0
  [ 84] pop 1 ................................... end case
  [ 86] jmp [105]
  [ 89] peek 0
  [ 91] pushsymb 663 ............................ <#script>
  [ 94] eq
  [ 95] jmpifz [105] ............................ (case) #script:
  [ 98] pop 1
  [100] pushzero ................................ <0>
  [101] pusharglistnoret 1 ...................... <0>
  [103] extcall 107 ............................. return 0
  [105] pop 1 ................................... end case
  [107] ret
end

