on getBehaviorTooltip aScript
  [  0] pushcons 8 .............................. <"Updates 3D models based on a physical simulation">
  [  2] pushcons 9 .............................. <RETURN>
  [  4] joinstr ................................. <"Updates 3D models based on a physical simulation" & RETURN>
  [  5] pushcons 9 .............................. <RETURN>
  [  7] joinstr ................................. <"Updates 3D models based on a physical simulation" & RETURN & RETURN>
  [  8] setlocal 0 .............................. tString1 = "Updates 3D models based on a physical simulation" & RETURN & RETURN
  [ 10] pushcons 10 ............................. <"-">
  [ 12] pushcons 11 ............................. <"Type">
  [ 14] joinpadstr .............................. <"-" && "Type">
  [ 15] pushcons 12 ............................. <":">
  [ 17] joinpadstr .............................. <"-" && "Type" && ":">
  [ 18] pushcons 13 ............................. <"Independent Action">
