global gGame, gUser, gWindow, gTimeFactor, gPausedMusicState, gGameState, _VERSION, _DEBUG

on prepareMovie
  [  0] gettoplevelprop 23 ...................... <_movie>
  [  2] pushint8 1 .............................. <1>
  [  4] setobjprop 770 .......................... _movie.exitLock = 1
  [  7] pushsymb 742 ............................ <#menu>
  [ 10] setglobal 767 ........................... gGameState = #menu
  [ 13] pushcons 0 .............................. <"keyHit">
  [ 15] pushint8 3 .............................. <3>
  [ 17] set 0 ................................... set the keyDownScript to "keyHit"
  [ 19] pushzero ................................ <0>
  [ 20] setglobal 20 ............................ gWindow = 0
  [ 22] pushcons 1 .............................. <"FULL">
  [ 24] setglobal 21 ............................ _VERSION = "FULL"
  [ 26] pushzero ................................ <0>
  [ 27] setglobal 22 ............................ _DEBUG = 0
  [ 29] ret
end

on gotoMenu
  [  0] gettoplevelprop 23 ...................... <_movie>
  [  2] pushcons 2 .............................. <"menu">
  [  4] pusharglistnoret 2 ...................... <_movie, "menu">
  [  6] objcall 24 .............................. _movie.go("menu")
  [  8] ret
end

